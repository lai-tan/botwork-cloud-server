# botwork-cloud-server --schedule 调度守护进程配置
# 被 systemd unit (EnvironmentFile) / SysV init 脚本 / nohup 启动脚本 / watchdog.sh 共同 source
# 由 install-schedule-daemon.sh 生成到 /root/bot-work/schedule-daemon.env（权限 600，含 API key）
#
# 管理 API 端口说明：默认 8081（仅绑定 127.0.0.1，bot-work-windows 前端 SSH 同步协议
# 写死 8081，改动此值须同步改前端 commands/schedule.rs 的 remote_admin_request）。
# 若既有 botwork-cloud-server --listen ws://127.0.0.1:8081 常驻服务占用该端口，
# install-schedule-daemon.sh 会自动将其迁移为 --listen off（释放 8081）。
# 调度进程自带进程内 adapter（SCHEDULE_BASE_URL + 随机端口），不依赖任何既有常驻服务。

# Agnes API key（必填）——进程内设为 OPENAI_API_KEY/AGNES_API_KEY 供 codex env_key 读取
# 注意：本文件入 git，禁止提交真实 key；真实 key 只写在部署机本地生成的 schedule-daemon.env
SCHEDULE_API_KEY=sk-your-api-key-here

# 上游 base URL（必填）——传 api-key+base-url 时进程内启动 adapter（Agnes 为 Chat
# Completions API，codex 需 responses 接口，adapter 负责转换；不指定 adapter-port
# 即随机端口，自包含不依赖既有常驻服务、不与 8082 冲突）
SCHEDULE_BASE_URL=https://apihub.agnes-ai.com/v1

# 管理 API 端口（默认 8081）
SCHEDULE_HEALTH_PORT=8081

# schedules.json 路径（首次部署不存在时进程自动创建空配置 {"schedules":[]}）
SCHEDULE_CONFIG=/root/bot-work/schedules.json

# bot-web-server 推送地址（push_to_bot 任务的结果通知目标，§5.4：通知丢失不补发）
SCHEDULE_BOT_WEB_URL=https://bot.xqx.us.kg/api/v1

# 推送通知目标用户名（bot-web-server 按用户名落通知，须是已注册的活跃用户）
SCHEDULE_BOT_WEB_USERNAME=testuser

# 推送通知 service token（须与 bot-web-server 侧 NOTIFICATION_PUSH_TOKEN 一致）
SCHEDULE_BOT_WEB_PUSH_TOKEN=change-me-notification-push-token

# 并发与超时（§5.2.1：槽位拆分 normal 3 + handoff 2）
SCHEDULE_MAX_CONCURRENT=5
SCHEDULE_HANDOFF_SLOTS=2
SCHEDULE_MAX_EXECUTION_TIME=1800

# 管理 API 认证（默认注释=无认证：单用户 root 服务器 + SSH 通道认证已足够；
# 仅当同机存在不可信服务（可访问 127.0.0.1）时启用——启用后 POST/DELETE
# 须带 Authorization: Bearer <token>，健康端点保持免认证）
#SCHEDULE_API_TOKEN=